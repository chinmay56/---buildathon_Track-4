# ─────────────────────────────────────────────────────────────────────────────
# Razorpay Settlement Controller — Environment Variable Reference
# Copy this file to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (used by the AI Investigator)
OPENAI_API_KEY=your_openai_api_key_here

# ── Razorpay API Credentials ──────────────────────────────────────────────────
# Obtain from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ── Razorpay OAuth 2.0 Partner Credentials ────────────────────────────────────
# Obtain from https://dashboard.razorpay.com → Partners → OAuth Applications
RAZORPAY_OAUTH_CLIENT_ID=rzp_partner_your_client_id_here
RAZORPAY_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# ── Supabase Cloud Configuration ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Database Configuration ────────────────────────────────────────────────────
# SQLite (default, zero-setup): sqlite:///./settlement_ledger.db
# PostgreSQL / Supabase: postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///./settlement_ledger.db
ENVIRONMENT=development

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Demo Auth Tokens (optional override) ─────────────────────────────────────
# Override the default stable demo tokens used by /api/auth/login.
# DEMO_TOKEN_CONTROLLER=your_custom_controller_token
# DEMO_TOKEN_AUDITOR=your_custom_auditor_token
# DEMO_TOKEN_OPERATOR=your_custom_operator_token
